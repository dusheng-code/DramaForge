# ─────────────────────────────────────────────────────────────
# DramaForge 全量配置（§11）。真值由 core/config.py 的 Settings 定义，
# 此文件只做示例占位：复制为 .env 后填写真实值。
# ─────────────────────────────────────────────────────────────

# ── 运行时与全局 ───────────────────────────────────────────────
RUNTIME_DIR=./var
STRICT_MODE=false
TOPIC_DEFAULT_EPISODES=8
EPISODE_DURATION_TARGET_SEC=75
EPISODE_DURATION_RANGE_SEC=60,90
MIN_SHOT_PER_EPISODE=6
MAX_SHOT_PER_EPISODE=12
SHOT_DURATION_LADDER=6,10
CHARS_PER_SEC=4.5
HERO_MAX_RATIO=0.20
MAX_REVISION_PER_SLOT=2
MAX_ATTEMPT_PER_SHOT=3

# ── 存储 ─────────────────────────────────────────────────────
# uvicorn 必须 1 worker；MySQL 是唯一事实源
TASK_STATE_DB=mysql+aiomysql://root:your_password@127.0.0.1:3306/dramaforge
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=drama_card
EMBED_MODEL=BGE-M3
EMBED_DIM=1024
RRF_K=60
CARD_TOP_K=8
CARD_MILVUS_TIMEOUT_SEC=8

# ── 图像 ─────────────────────────────────────────────────────
IMAGE_PROVIDER=minimax
IMAGE_MODEL=TBD_M8
IMAGE_CONCURRENCY=2
IMAGE_PRICE_CNY=0.2
IMAGE_RESOLUTION=768p
IMAGE_ASPECT=16:9

# ── 视频 ─────────────────────────────────────────────────────
VIDEO_PROVIDER=minimax
VIDEO_MODEL_FAST=hailuo-2.3-fast
VIDEO_MODEL_HERO=hailuo-2.3
VIDEO_RESOLUTION=768p
VIDEO_ASPECT=16:9
TIER_PRICE=fast:0.225,hero:0.400
IMAGE_TO_VIDEO=true
GENERATE_WITH_AUDIO=false

# ── 资产泵 ───────────────────────────────────────────────────
ASSET_CONCURRENCY=3
POLL_BACKOFF=20,40,80
POLL_TIMEOUT_SEC=1200
DOWNLOAD_TIMEOUT_SEC=120

# ── 预算 ─────────────────────────────────────────────────────
MAX_VIDEO_COST_CNY=500
MAX_EPISODE_COST_CNY=65
REQUIRE_QUOTE_APPROVAL=true

# ── 调试 ─────────────────────────────────────────────────────
# >0 只跑前 N 集
EPISODE_LIMIT=0

# ── LLM role ────────────────────────────────────────────────
LLM_ROLE_KEYS=reference,constraint,script,storyboard,prompt_pack,review,tagger

LLM_REFERENCE_API_KEY=
LLM_REFERENCE_BASE_URL=https://api.deepseek.com/v1
LLM_REFERENCE_MODEL=deepseek-chat
LLM_REFERENCE_TEMPERATURE=0.3
LLM_REFERENCE_MAX_TOKENS=4000

LLM_CONSTRAINT_API_KEY=
LLM_CONSTRAINT_BASE_URL=https://api.deepseek.com/v1
LLM_CONSTRAINT_MODEL=deepseek-chat
LLM_CONSTRAINT_TEMPERATURE=0.2
LLM_CONSTRAINT_MAX_TOKENS=4000

LLM_SCRIPT_API_KEY=
LLM_SCRIPT_BASE_URL=https://api.deepseek.com/v1
LLM_SCRIPT_MODEL=deepseek-chat
LLM_SCRIPT_TEMPERATURE=0.8
LLM_SCRIPT_MAX_TOKENS=8000

LLM_STORYBOARD_API_KEY=
LLM_STORYBOARD_BASE_URL=https://api.deepseek.com/v1
LLM_STORYBOARD_MODEL=deepseek-chat
LLM_STORYBOARD_TEMPERATURE=0.6
LLM_STORYBOARD_MAX_TOKENS=8000

LLM_PROMPT_PACK_API_KEY=
LLM_PROMPT_PACK_BASE_URL=https://api.deepseek.com/v1
LLM_PROMPT_PACK_MODEL=deepseek-chat
LLM_PROMPT_PACK_TEMPERATURE=0.4
LLM_PROMPT_PACK_MAX_TOKENS=4000

LLM_REVIEW_API_KEY=
LLM_REVIEW_BASE_URL=https://api.deepseek.com/v1
LLM_REVIEW_MODEL=deepseek-chat
LLM_REVIEW_TEMPERATURE=0.5
LLM_REVIEW_MAX_TOKENS=2000

LLM_TAGGER_API_KEY=
LLM_TAGGER_BASE_URL=https://api.deepseek.com/v1
LLM_TAGGER_MODEL=deepseek-chat
LLM_TAGGER_TEMPERATURE=0.0
LLM_TAGGER_MAX_TOKENS=1000

# ── 检索类外部 API（公域时效）───────────────────────────────
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
ANSPIRE_API_KEY=
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch
SEARCH_TIMEOUT_SEC=20

# ── MiniMax（图像/视频，字段名见 §14 未核实项）──────────────
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat
MINIMAX_IMAGE_PATH=/v1/image_generation
MINIMAX_VIDEO_SUBMIT_PATH=/v1/video_generation
MINIMAX_VIDEO_QUERY_PATH=/query/video_generation
MINIMAX_FILE_RETRIEVE_PATH=/v1/files/retrieve
MINIMAX_GROUP_ID=

# ── 可复现 ─────────────────────────────────────────────────
LLM_SEED=20250101
DRY_RUN=false
